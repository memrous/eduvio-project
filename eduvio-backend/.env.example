# ─────────────────────────────────────────────────────────────────────
# Eduvio backend – production configuration template
# Copy to .env and fill in the empty values. For local development with
# Sail see .env.local.example (overrides of the values below).
# Comments are on their own lines on purpose (inline comments are easy
# to break with an unquoted "#").
# ─────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────
APP_NAME=Eduvio
APP_ENV=production
# Generate once with `php artisan key:generate --show` and NEVER change it:
# it encrypts the stored Moodle token and STAG ticket. Back it up.
APP_KEY=
APP_DEBUG=false
# Public URL of the backend (used for links to uploaded files, e.g. /api/materials/{id}/file)
APP_URL=https://api.example.com
# Old keys after a rotation, comma-separated (normally empty)
APP_PREVIOUS_KEYS=

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Frontend / CORS ──────────────────────────────────────────────────
# Origin of the built frontend; the only origin allowed by CORS and where
# the STAG and Moodle logins return to
FRONTEND_URL=https://eduvio.example.com
# Only for cookie (stateful) auth; the app uses Bearer tokens, so usually not needed
# SANCTUM_STATEFUL_DOMAINS=eduvio.example.com
SANCTUM_TOKEN_PREFIX=

# ── Registration ─────────────────────────────────────────────────────
# Self-registration; off in production (POST /api/register answers 403)
REGISTRATION_ENABLED=false
# Optional comma-separated e-mail domains allowed to register, e.g. upol.cz,student.upol.cz
REGISTRATION_ALLOWED_DOMAINS=

# ── IS/STAG ──────────────────────────────────────────────────────────
STAG_WS_BASE_URL=https://stag-ws.upol.cz/ws
# agent = the student's local agent (stag_mock_import/stag_agent.py) syncs STAG;
# server = the backend logs in to STAG and syncs it itself
STAG_MODE=agent
# Lifetime of the agent token created in the profile, in days
STAG_AGENT_TOKEN_TTL_DAYS=180
# server mode only: browser-facing base URL STAG returns to after login
STAG_CALLBACK_URL=https://api.example.com
# server mode only: URL of this backend as seen by the queue worker (Docker network)
LARAVEL_INTERNAL_URL=http://localhost

# ── Moodle ───────────────────────────────────────────────────────────
MOODLE_BASE_URL=https://moodle.upol.cz
# URL scheme of the Moodle mobile launch that returns the token to the app
MOODLE_LAUNCH_URLSCHEME=web+eduvio
# How long a started Moodle login may take, in minutes
MOODLE_LAUNCH_TTL_MINUTES=15

# ── Teachers' course pages (department websites) ─────────────────────
DEPARTMENT_KMI_BASE_URL=https://www.inf.upol.cz
# Contact sent in the User-Agent of the page crawler (defaults to APP_URL)
DEPARTMENT_BOT_CONTACT=
DEPARTMENT_HTTP_TIMEOUT=10
# Minimum pause between two requests to the same website, in milliseconds
DEPARTMENT_MIN_REQUEST_INTERVAL_MS=1000
DEPARTMENT_CACHE_TTL_HOURS=24
# Minimum time between two manual refreshes by one user, in minutes
DEPARTMENT_REFRESH_COOLDOWN_MINUTES=30

# ── Logging ──────────────────────────────────────────────────────────
# stderr = the container log (Render → Logs); files in storage/logs are lost on every deploy
LOG_CHANNEL=stderr
# Only used with LOG_CHANNEL=stack (a server with a persistent disk)
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────
# Supabase Postgres through the connection pooler in SESSION mode
# (Project → Connect → Session pooler). The direct connection
# db.<project-ref>.supabase.co is IPv6 only, which Render cannot reach.
DB_CONNECTION=pgsql
# aws-0-<region>.pooler.supabase.com (the region of the project, e.g. eu-central-1)
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# 5432 = session mode (6543 is transaction mode, not suitable for Laravel)
DB_PORT=5432
DB_DATABASE=postgres
# Pooler user: postgres.<project-ref>
DB_USERNAME=postgres.your-project-ref
# Database password of the Supabase project
DB_PASSWORD=
# Supabase requires TLS
DB_SSLMODE=require
# Or one connection string instead of the values above
# DB_URL=

# ── Sessions, cache, queue ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Background jobs (STAG/Moodle sync, course pages) need `php artisan queue:work`
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Also stores the login/registration rate limits
CACHE_STORE=database
CACHE_PREFIX=eduvio_

# ── Redis (only when CACHE_STORE / QUEUE_CONNECTION / SESSION_DRIVER = redis) ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (the app sends no e-mails yet) ──────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="eduvio@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Uploaded materials ───────────────────────────────────────────────
# Disk for files users upload: local (storage/app/private) or s3. Files are
# private and streamed only through GET /api/materials/{id}/file.
MATERIALS_DISK=s3

# S3 disk – Supabase Storage over its S3 API (Project Settings → Storage → S3
# connection). Create a PRIVATE bucket; the keys are the S3 access keys from there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region of the Supabase project, e.g. eu-central-1
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=materials
# https://<project-ref>.supabase.co/storage/v1/s3
AWS_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
# Supabase needs path-style addressing (bucket in the path, not the host)
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public URL of the bucket; not used (files are never linked directly)
AWS_URL=

# Other variables read by config/ for drivers this app does not use are left
# out on purpose and keep their framework defaults: AUTH_*, DB_CACHE_*,
# DB_QUEUE_*, DB_SOCKET, DB_CHARSET, DB_COLLATION, DB_ENCRYPT, DB_FOREIGN_KEYS,
# DB_TRUST_SERVER_CERTIFICATE, MYSQL_ATTR_SSL_CA, CACHE_STORAGE_*, DYNAMODB_*,
# MEMCACHED_*, REDIS_* (cluster, backoff, per-store DBs), BEANSTALKD_*, SQS_*,
# LOG_DEPRECATIONS_TRACE, LOG_STDERR_FORMATTER,
# LOG_SYSLOG_FACILITY, LOG_PAPERTRAIL_HANDLER, PAPERTRAIL_*, LOG_SLACK_*,
# SLACK_BOT_*, MAIL_URL, MAIL_EHLO_DOMAIN, MAIL_LOG_CHANNEL,
# MAIL_SENDMAIL_PATH, POSTMARK_*, RESEND_API_KEY, SESSION_CONNECTION,
# SESSION_STORE, SESSION_TABLE, SESSION_EXPIRE_ON_CLOSE, SESSION_HTTP_ONLY,
# SESSION_SAME_SITE, SESSION_PARTITIONED_COOKIE.
