# ─────────────────────────────────────────────────────────────────────
# Eduvio backend – local development with Laravel Sail
# Start from .env.example and override these values in your .env
# (or copy this file over .env and add APP_KEY with `sail artisan key:generate`).
# ─────────────────────────────────────────────────────────────────────

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en

# Vite dev server of eduvio-frontend
FRONTEND_URL=http://localhost:5173

# Registration is handy for test accounts
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_DOMAINS=

# server mode: STAG login in the browser, the backend syncs STAG itself
STAG_MODE=server
STAG_CALLBACK_URL=http://localhost
# Queue container → web container inside the Sail network
LARAVEL_INTERNAL_URL=http://laravel.test

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Sail database service
DB_CONNECTION=pgsql
DB_HOST=pgsql
# The Sail database has no TLS
DB_SSLMODE=prefer
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_SECURE_COOKIE=false
# Uploaded materials in storage/app/private (no S3 needed locally)
MATERIALS_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
