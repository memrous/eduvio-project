# Frontend ignorované soubory
eduvio-frontend/node_modules/
eduvio-frontend/.env
eduvio-frontend/.env.development
eduvio-frontend/.env.production
eduvio-frontend/.env.*.local
eduvio-frontend/dist/

# Backend ignorované soubory
eduvio-backend/.env
eduvio-backend/vendor/
eduvio-backend/storage/*.key
eduvio-backend/storage/framework/cache/data/*
eduvio-backend/storage/framework/views/*
eduvio-backend/storage/framework/sessions/*
eduvio-backend/storage/logs/*.log
eduvio-backend/bootstrap/cache/*

# Databázové dumpy (mohou obsahovat osobní údaje a tokeny)
*.sql

# Lokální konfigurace STAG agenta (obsahuje token)
stag_mock_import/**/config.json

# Systémové soubory
.DS_Store
Thumbs.db
.vscode/
*.code-workspace
# Python cache
__pycache__/
*.py[cod]
