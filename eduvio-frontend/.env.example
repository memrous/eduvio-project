# Eduvio frontend – build-time configuration (Vite reads it at `npm run build`)
# Copy to .env.local (development) or set in the build environment.

# Address of the Laravel API including /api
# Production example: https://api.example.com/api
VITE_API_BASE_URL=http://localhost:80/api

# true = the app runs against the in-browser mock API (no backend); never in production
VITE_USE_MOCK=false

# Optional: link to the STAG agent guide (default: AGENT.md on GitHub)
# VITE_AGENT_GUIDE_URL=https://github.com/memrous/eduvio-project/blob/main/stag_mock_import/AGENT.md

# Mock API only: STAG mode the mock pretends the backend has (server | agent)
VITE_MOCK_STAG_MODE=server
